{
	"name": "pnpm-cloudflare-tanstack-template",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.34.7",
	"scripts": {
		"setup-project": "tsx scripts/setup-project.ts",
		"dev": "pnpm setup:local && pnpm db:migrate && pnpm -r --parallel --filter api --filter marketing --filter dashboard dev",
		"dev:api": "pnpm setup:local && pnpm db:migrate && pnpm --filter api dev",
		"dev:marketing": "pnpm --filter marketing dev",
		"dev:dashboard": "pnpm --filter dashboard dev",
		"db:migrate": "pnpm --filter api db:migrate",
		"db:migrate:remote": "pnpm --filter api db:migrate:remote",
		"build": "pnpm -r run build",
		"build:marketing": "pnpm --filter marketing build",
		"build:dashboard": "pnpm --filter dashboard build",
		"test": "pnpm db:check && pnpm test:unit && tsx tests/run-local.ts",
		"typecheck": "pnpm typecheck:tools && pnpm -r --parallel run typecheck",
		"lint": "oxlint",
		"format": "oxfmt . --write",
		"format:check": "oxfmt . --check",
		"precommit:check": "pnpm check",
		"check": "pnpm lint && pnpm format:check && pnpm test && pnpm typecheck && pnpm build",
		"deploy": "pnpm db:migrate:remote && pnpm deploy:api && pnpm deploy:marketing && pnpm deploy:dashboard",
		"deploy:api": "pnpm --filter api run deploy",
		"deploy:marketing": "pnpm --filter marketing build && pnpm --filter marketing run deploy",
		"deploy:dashboard": "pnpm --filter dashboard build && pnpm --filter dashboard run deploy",
		"prepare": "git config core.hooksPath .githooks",
		"setup:local": "tsx scripts/setup-local.ts",
		"validate": "pnpm check",
		"db:generate": "pnpm --filter @workspace/data db:generate",
		"db:check": "pnpm --filter @workspace/data db:check && tsx scripts/check-schema.ts",
		"typecheck:tools": "tsc -p tsconfig.tools.json && tsc -p tests/support/workers/tsconfig.json",
		"api:generate": "orval --config orval.config.ts",
		"test:unit": "node --import tsx --experimental-sqlite --test tests/unit/*.test.ts"
	},
	"devDependencies": {
		"@dotenvx/dotenvx": "^2.38.0",
		"@types/node": "26.6.5",
		"effect": "4.0.5",
		"orval": "8.43.0",
		"oxfmt": "^0.73.0",
		"oxlint": "^1.88.0",
		"tsx": "4.23.15",
		"typescript": "7.0.2",
		"wrangler": "^4.151.1",
		"zod": "4.6.7"
	},
	"engines": {
		"node": ">=26.12.0 <27"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "26.12.0",
			"onFail": "download"
		}
	}
}
