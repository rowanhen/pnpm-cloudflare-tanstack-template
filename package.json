{
	"name": "pnpm-cloudflare-tanstack-template",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.34.7",
	"scripts": {
		"setup-project": "tsx scripts/setup-project.ts",
		"dev": "pnpm setup:local && pnpm db:migrate && pnpm -r --parallel --filter api --filter marketing --filter dashboard dev",
		"dev:api": "pnpm setup:local && pnpm db:migrate && pnpm --filter api dev",
		"dev:marketing": "pnpm --filter marketing dev",
		"dev:dashboard": "pnpm --filter dashboard dev",
		"db:migrate": "pnpm --filter api db:migrate",
		"db:migrate:remote": "pnpm --filter api db:migrate:remote",
		"build": "pnpm -r run build",
		"build:marketing": "pnpm --filter marketing build",
		"build:dashboard": "pnpm --filter dashboard build",
		"test": "pnpm db:check && pnpm test:setup && tsx scripts/test-local.ts",
		"test:remote": "tsx scripts/test-remote.ts",
		"test:browser": "tsx scripts/test-browser.ts",
		"typecheck": "pnpm typecheck:tools && pnpm -r --parallel run typecheck",
		"lint": "oxlint",
		"lint:all": "oxlint",
		"format": "oxfmt . --write",
		"format:check": "oxfmt . --check",
		"precommit:check": "pnpm check",
		"check": "pnpm api:check && pnpm test:contracts && pnpm lint && pnpm format:check && pnpm test && pnpm typecheck && pnpm build",
		"deploy": "tsx scripts/deploy.ts",
		"deploy:api": "pnpm --filter api deploy",
		"deploy:marketing": "tsx scripts/deploy.ts marketing",
		"deploy:dashboard": "tsx scripts/deploy.ts dashboard",
		"hooks:install": "tsx scripts/install-precommit-hook.ts",
		"prepare": "pnpm run hooks:install",
		"setup:local": "tsx scripts/setup-local.ts",
		"test:dev": "tsx scripts/test-browser.ts --dev",
		"stripe:setup": "tsx scripts/stripe-demo.ts setup",
		"stripe:cleanup": "tsx scripts/stripe-demo.ts cleanup",
		"setup:doctor": "tsx scripts/doctor.ts",
		"validate": "tsx scripts/validate.ts",
		"cloud:up": "tsx scripts/cloud.ts up",
		"cloud:check": "tsx scripts/cloud.ts check",
		"cloud:down": "tsx scripts/cloud.ts down",
		"test:cloud-setup": "tsx scripts/test-cloud-setup.ts",
		"test:setup": "node --import tsx --experimental-sqlite --test scripts/setup.test.ts scripts/migrations.test.ts scripts/site-domain.test.ts scripts/observability.test.ts",
		"db:generate": "pnpm --filter @workspace/data db:generate",
		"db:check": "pnpm --filter @workspace/data db:check && tsx scripts/check-schema.ts",
		"email:setup": "tsx scripts/email-domain.ts setup",
		"email:check": "tsx scripts/email-domain.ts check",
		"typecheck:tools": "tsx scripts/check-typescript.ts && tsc -p tsconfig.tools.json && tsc -p scripts/workers/tsconfig.json",
		"cloud:domain": "tsx scripts/cloud.ts domain",
		"generate:social": "tsx scripts/generate-social-image.ts",
		"posthog:setup": "tsx scripts/posthog.ts setup",
		"posthog:report": "tsx scripts/posthog.ts report",
		"api:generate": "tsx scripts/generate-api.ts",
		"api:check": "tsx scripts/generate-api.ts --check",
		"test:contracts": "node --import tsx --test scripts/contracts.test.ts scripts/api-contract.test.ts"
	},
	"devDependencies": {
		"@apidevtools/swagger-parser": "^13.1.0",
		"@playwright/test": "^1.64.1",
		"@types/node": "26.6.5",
		"effect": "4.0.5",
		"openapi-types": "^12.1.3",
		"orval": "8.43.0",
		"oxfmt": "^0.73.0",
		"oxlint": "^1.88.0",
		"stripe": "23.0.0",
		"tsx": "4.23.15",
		"typescript": "7.0.2",
		"wrangler": "^4.151.1",
		"zod": "4.6.7"
	},
	"engines": {
		"node": ">=26.12.0 <27"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "26.12.0",
			"onFail": "download"
		}
	}
}
