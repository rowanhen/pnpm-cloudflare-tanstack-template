{
	"name": "api",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "wrangler dev --port 8787",
		"build": "wrangler deploy --dry-run --outdir dist",
		"typecheck": "tsc --noEmit",
		"db:migrate": "pnpm --dir ../.. db:migrate",
		"db:migrate:remote": "pnpm --dir ../.. db:migrate:remote",
		"deploy": "wrangler deploy"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261110.1",
		"typescript": "^7.0.2",
		"wrangler": "^4.160.0"
	},
	"dependencies": {
		"@workspace/contracts": "workspace:*",
		"@workspace/data": "workspace:*",
		"@workspace/observability": "workspace:*",
		"better-auth": "^1.7.19",
		"drizzle-orm": "0.45.4",
		"effect": "4.1.3",
		"hono": "4.13.17",
		"stripe": "^23.1.0"
	}
}
