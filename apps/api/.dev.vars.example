# Run pnpm setup:local to generate BETTER_AUTH_SECRET safely.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloud deployments only: set the same value on both Pages projects and the Worker.
# API_PROXY_SECRET=separate-random-secret

# Optional one-time Stripe test checkout. Run pnpm stripe:setup after adding test keys.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Cloudflare Email Service sender on a verified domain.
# Wrangler dev simulates sending unless you explicitly enable a remote binding.
EMAIL_FROM=

# PostHog public project token and matching regional ingestion host (optional).
# POSTHOG_KEY=phc_...
# POSTHOG_HOST=https://eu.i.posthog.com
# APP_ENV=development
