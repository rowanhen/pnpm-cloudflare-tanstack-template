{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "pnpm-cloudflare-tanstack-template-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	"workers_dev": true,
	"vars": {
		"ALLOWED_ORIGINS": "http://localhost:3000,http://localhost:3001",
		"AUTH_URL": "http://localhost:3001"
	},
	"d1_databases": [
		{
			"binding": "IDENTITY_DB",
			"database_name": "pnpm-cloudflare-tanstack-template-identity",
			"database_id": "00000000-0000-0000-0000-000000000001",
			"migrations_dir": "migrations/identity"
		},
		{
			"binding": "BILLING_DB",
			"database_name": "pnpm-cloudflare-tanstack-template-billing",
			"database_id": "00000000-0000-0000-0000-000000000002",
			"migrations_dir": "migrations/billing"
		},
		{
			"binding": "PRODUCT_DB",
			"database_name": "pnpm-cloudflare-tanstack-template-product",
			"database_id": "00000000-0000-0000-0000-000000000003",
			"migrations_dir": "migrations/product"
		}
	],
	"r2_buckets": [
		{
			"binding": "FILES",
			"bucket_name": "pnpm-cloudflare-tanstack-template-files"
		}
	],
	"compatibility_flags": ["nodejs_compat"],
	"send_email": [
		{
			"name": "EMAIL"
		}
	],
	"observability": {
		"enabled": true
	}
}
