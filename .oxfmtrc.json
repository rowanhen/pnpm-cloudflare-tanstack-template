{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"printWidth": 100,
	"singleQuote": true,
	"trailingComma": "all",
	"semi": false,
	"sortPackageJson": false,
	"ignorePatterns": [
		"apps/*/src/routeTree.gen.ts",
		"node_modules",
		"dist",
		"**/.output/**",
		"**/.wrangler/**",
		"playwright-report",
		"test-results"
	]
}
