{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": ["node"],
		"strict": true,
		"noEmit": true,
		"allowJs": false,
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"resolveJsonModule": true
	},
	"include": [
		"scripts/**/*.ts",
		"codegen/**/*.ts",
		"tests/**/*.ts",
		"packages/data/drizzle.config.ts",
		"orval.config.ts"
	],
	"exclude": ["node_modules", "tests/support/workers"]
}
