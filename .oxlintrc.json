{
	"$schema": "https://raw.githubusercontent.com/nicolo-ribaudo/oxlint/refs/heads/main/.oxlintrc.json",
	"plugins": ["react", "typescript", "jsx-a11y", "import"],
	"categories": {
		"correctness": "warn",
		"suspicious": "warn"
	},
	"rules": {
		"no-unused-vars": "warn",
		"import/no-duplicates": "warn",
		"react/no-array-index-key": "off",
		"react/no-danger": "off",
		"react/react-in-jsx-scope": "off",
		"typescript/no-explicit-any": "warn",
		"typescript/no-non-null-assertion": "warn",
		"jsx-a11y/anchor-is-valid": [
			"warn",
			{
				"specialLink": ["to"]
			}
		],
		"jsx-a11y/no-redundant-roles": [
			"warn",
			{
				"a": ["link"]
			}
		]
	},
	"ignorePatterns": [
		"apps/*/src/routeTree.gen.ts",
		"node_modules",
		"dist",
		"**/.output/**",
		"**/.wrangler/**"
	],
	"settings": {
		"jsx-a11y": {
			"components": {
				"Link": "a"
			}
		}
	},
	"overrides": [
		{
			"files": ["apps/api/src/**/*.ts"],
			"rules": {
				"typescript/no-explicit-any": "error",
				"typescript/no-non-null-assertion": "error",
				"no-unused-vars": "error",
				"typescript/no-unused-expressions": "error",
				"no-restricted-globals": [
					"error",
					{
						"name": "process",
						"message": "Cloudflare bindings belong at request boundaries; do not read process state."
					}
				],
				"no-underscore-dangle": [
					"error",
					{
						"allow": ["_tag"]
					}
				]
			}
		}
	]
}
