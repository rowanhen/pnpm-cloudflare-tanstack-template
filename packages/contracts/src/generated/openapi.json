		"schemas": {
			"Todo": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"id": {
						"type": "string"
					},
					"title": {
						"type": "string",
						"minLength": 1,
						"maxLength": 200
					},
					"completed": {
						"type": "boolean"
					},
					"created_at": {
						"type": "string"
					}
				},
				"required": ["id", "title", "completed", "created_at"]
			},
			"TodoResponse": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"todo": {
						"$ref": "#/components/schemas/Todo"
					}
				},
				"required": ["todo"]
			},
			"TodosResponse": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"todos": {
						"type": "array",
						"items": {
							"$ref": "#/components/schemas/Todo"
						},
						"maxItems": 100
					}
				},
				"required": ["todos"]
			},
			"CreateTodoInput": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"title": {
						"type": "string",
						"minLength": 1,
						"maxLength": 200,
						"pattern": "\\S"
					}
				},
				"required": ["title"]
			},
			"UpdateTodoInput": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"title": {
						"type": "string",
						"minLength": 1,
						"maxLength": 200,
						"pattern": "\\S"
					},
					"completed": {
						"type": "boolean"
					}
				},
				"minProperties": 1
			},
			"TodoNotFound": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"code": {
						"type": "string",
						"enum": ["todo_not_found"]
					},
					"error": {
						"type": "string"
					}
				},
				"required": ["code", "error"]
			},
