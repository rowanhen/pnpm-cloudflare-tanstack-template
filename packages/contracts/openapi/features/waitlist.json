{
	"paths": {
		"/api/waitlist": {
			"post": {
				"operationId": "joinWaitlist",
				"tags": ["waitlist"],
				"responses": {
					"202": {
						"description": "Success",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"additionalProperties": false,
									"properties": {
										"message": {
											"type": "string"
										}
									},
									"required": ["message"]
								}
							}
						}
					},
					"400": {
						"$ref": "../shared/errors.json#/components/responses/BadRequest"
					},
					"401": {
						"$ref": "../shared/errors.json#/components/responses/Unauthorized"
					},
					"403": {
						"$ref": "../shared/errors.json#/components/responses/Forbidden"
					},
					"500": {
						"$ref": "../shared/errors.json#/components/responses/InternalError"
					},
					"503": {
						"$ref": "../shared/errors.json#/components/responses/Unavailable"
					},
					"413": {
						"$ref": "../shared/errors.json#/components/responses/PayloadTooLarge"
					},
					"415": {
						"$ref": "../shared/errors.json#/components/responses/UnsupportedMediaType"
					},
					"429": {
						"$ref": "../shared/errors.json#/components/responses/TooManyRequests"
					}
				},
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/WaitlistInput"
							}
						}
					}
				},
				"security": [],
				"x-require-origin": false
			}
		},
		"/api/waitlist/me": {
			"get": {
				"operationId": "getWaitlistStatus",
				"tags": ["waitlist"],
				"responses": {
					"200": {
						"description": "Success",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"additionalProperties": false,
									"properties": {
										"joined": {
											"type": "boolean"
										},
										"entry": {
											"type": "object",
											"additionalProperties": false,
											"properties": {
												"created_at": {
													"type": "string"
												}
											},
											"required": ["created_at"],
											"nullable": true
										}
									},
									"required": ["joined", "entry"]
								}
							}
						}
					},
					"400": {
						"$ref": "../shared/errors.json#/components/responses/BadRequest"
					},
					"401": {
						"$ref": "../shared/errors.json#/components/responses/Unauthorized"
					},
					"403": {
						"$ref": "../shared/errors.json#/components/responses/Forbidden"
					},
					"500": {
						"$ref": "../shared/errors.json#/components/responses/InternalError"
					},
					"503": {
						"$ref": "../shared/errors.json#/components/responses/Unavailable"
					}
				}
			}
		}
	},
	"components": {
		"schemas": {
			"WaitlistInput": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"email": {
						"type": "string",
						"format": "email",
						"maxLength": 254
					},
					"name": {
						"type": "string",
						"maxLength": 100,
						"default": ""
					},
					"consent": {
						"type": "boolean",
						"enum": [true]
					},
					"website": {
						"type": "string"
					}
				},
				"required": ["email", "consent"]
			}
		}
	}
}
