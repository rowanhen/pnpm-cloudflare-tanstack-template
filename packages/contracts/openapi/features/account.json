{
	"paths": {
		"/api/me": {
			"get": {
				"operationId": "getMe",
				"tags": ["account"],
				"responses": {
					"200": {
						"description": "Success",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"additionalProperties": false,
									"properties": {
										"user": {
											"$ref": "#/components/schemas/User"
										}
									},
									"required": ["user"]
								}
							}
						}
					},
					"400": {
						"$ref": "../shared/errors.json#/components/responses/BadRequest"
					},
					"401": {
						"$ref": "../shared/errors.json#/components/responses/Unauthorized"
					},
					"403": {
						"$ref": "../shared/errors.json#/components/responses/Forbidden"
					},
					"500": {
						"$ref": "../shared/errors.json#/components/responses/InternalError"
					},
					"503": {
						"$ref": "../shared/errors.json#/components/responses/Unavailable"
					}
				}
			}
		}
	},
	"components": {
		"schemas": {
			"User": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"id": {
						"type": "string"
					},
					"name": {
						"type": "string"
					},
					"email": {
						"type": "string"
					},
					"emailVerified": {
						"type": "boolean"
					},
					"image": {
						"type": "string",
						"nullable": true
					}
				},
				"required": ["id", "name", "email", "emailVerified", "image"]
			}
		}
	}
}
